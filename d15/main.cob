IDENTIFICATION DIVISION.
PROGRAM-ID. DAY15.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT INFILE ASSIGN TO WS-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD INFILE.
01 IN-REC PIC X(40000).

WORKING-STORAGE SECTION.
01 WS-PATH PIC X(256) VALUE "in.txt".
01 WS-LEN PIC 9(5).
01 I PIC 9(5).
01 J PIC 9(5).
01 K PIC 9(5).
01 H PIC 9(5).
01 TOTAL1 PIC 9(9) VALUE 0.
01 TOTAL2 PIC 9(9) VALUE 0.
01 OUT-NUM PIC Z(8)9.
01 STEP-STR PIC X(20).
01 STEP-LEN PIC 99.
01 LABEL-STR PIC X(20).
01 LABEL-LEN PIC 99.
01 OP PIC X.
01 FOCAL PIC 9.
01 BOX-NO PIC 999.
01 FOUND PIC 9.
01 BOXES.
    05 BOX OCCURS 256 TIMES.
        10 BOX-N PIC 999 VALUE 0.
        10 LENS OCCURS 100 TIMES.
            15 LENS-LABEL PIC X(20).
            15 LENS-FOCAL PIC 9.

PROCEDURE DIVISION.
MAIN.
    ACCEPT WS-PATH FROM COMMAND-LINE
    IF WS-PATH = SPACES
        MOVE "in.txt" TO WS-PATH
    END-IF
    OPEN INPUT INFILE
    READ INFILE
    CLOSE INFILE
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(IN-REC TRAILING))
    MOVE SPACES TO STEP-STR
    MOVE 0 TO STEP-LEN
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > WS-LEN
        IF IN-REC(I:1) = ","
            PERFORM DO-STEP
        ELSE
            ADD 1 TO STEP-LEN
            MOVE IN-REC(I:1) TO STEP-STR(STEP-LEN:1)
        END-IF
    END-PERFORM
    PERFORM DO-STEP
    MOVE TOTAL1 TO OUT-NUM
    DISPLAY FUNCTION TRIM(OUT-NUM)
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 256
        PERFORM VARYING J FROM 1 BY 1 UNTIL J > BOX-N(I)
            COMPUTE TOTAL2 = TOTAL2 + I * J * LENS-FOCAL(I, J)
        END-PERFORM
    END-PERFORM
    MOVE TOTAL2 TO OUT-NUM
    DISPLAY FUNCTION TRIM(OUT-NUM)
    STOP RUN.

DO-STEP.
    MOVE 0 TO H
    PERFORM VARYING J FROM 1 BY 1 UNTIL J > STEP-LEN
        COMPUTE H = FUNCTION MOD((H + FUNCTION ORD(STEP-STR(J:1)) - 1) * 17, 256)
    END-PERFORM
    ADD H TO TOTAL1
    IF STEP-STR(STEP-LEN:1) = "-"
        MOVE "-" TO OP
        COMPUTE LABEL-LEN = STEP-LEN - 1
    ELSE
        MOVE "=" TO OP
        COMPUTE LABEL-LEN = STEP-LEN - 2
        MOVE STEP-STR(STEP-LEN:1) TO FOCAL
    END-IF
    MOVE SPACES TO LABEL-STR
    MOVE STEP-STR(1:LABEL-LEN) TO LABEL-STR
    MOVE 0 TO H
    PERFORM VARYING J FROM 1 BY 1 UNTIL J > LABEL-LEN
        COMPUTE H = FUNCTION MOD((H + FUNCTION ORD(LABEL-STR(J:1)) - 1) * 17, 256)
    END-PERFORM
    COMPUTE BOX-NO = H + 1
    MOVE 0 TO FOUND
    PERFORM VARYING J FROM 1 BY 1 UNTIL J > BOX-N(BOX-NO) OR FOUND = 1
        IF LENS-LABEL(BOX-NO, J) = LABEL-STR
            MOVE 1 TO FOUND
            MOVE J TO K
        END-IF
    END-PERFORM
    IF OP = "="
        IF FOUND = 1
            MOVE FOCAL TO LENS-FOCAL(BOX-NO, K)
        ELSE
            ADD 1 TO BOX-N(BOX-NO)
            MOVE LABEL-STR TO LENS-LABEL(BOX-NO, BOX-N(BOX-NO))
            MOVE FOCAL TO LENS-FOCAL(BOX-NO, BOX-N(BOX-NO))
        END-IF
    ELSE
        IF FOUND = 1
            PERFORM VARYING J FROM K BY 1 UNTIL J >= BOX-N(BOX-NO)
                MOVE LENS(BOX-NO, J + 1) TO LENS(BOX-NO, J)
            END-PERFORM
            SUBTRACT 1 FROM BOX-N(BOX-NO)
        END-IF
    END-IF
    MOVE SPACES TO STEP-STR
    MOVE 0 TO STEP-LEN.
